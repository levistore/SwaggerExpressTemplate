# ============================================================
# Copy jadi .env buat jalan lokal:  cp .env.example .env
# Di Vercel, isi lewat Settings -> Environment Variables (bukan file ini).
# Kalau pakai integrasi Neon dari Vercel Marketplace, dua variabel di bawah
# ini ke-inject otomatis — lu nggak perlu isi manual.
# ============================================================

# Connection string Postgres dari Neon.
# Ambil dari Neon dashboard -> Connection Details, atau otomatis lewat
# `vercel env pull` kalau project-nya udah nyambung ke integrasi Neon.
# Pakai yang ada "-pooler" di hostname-nya: itu yang aman buat serverless.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Opsional. Khusus `npm run db:migrate`.
# Kalau kosong, script-nya pakai DATABASE_URL di atas.
# DDL lebih aman lewat koneksi langsung (tanpa pooler) — kalau Neon nyediain
# variabel *UNPOOLED / *_NON_POOLING, taruh di sini.
MIGRATE_DATABASE_URL=

# Port server Express lokal. Vercel nggak butuh ini.
# Default 3000 kalau nggak diisi.
PORT=3000

# ============================================================
# WAJIB buat JWT. Server nggak akan jalan kalau ini kosong.
# Minimal 32 karakter. Generate yang acak:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Jangan pakai nilai contoh di bawah — itu cuma placeholder.
# Ganti nilai ini = semua token lama otomatis nggak valid lagi.
# ============================================================
JWT_SECRET=ganti-dengan-random-48-byte-base64url

# ============================================================
# KEAMANAN (Phase 1)
# ============================================================

# Daftar origin browser yang diizinkan akses API (CORS), dipisah koma.
# Frontend produksi dilayani dari domain yang SAMA dengan API, jadi biasanya
# KOSONG cukup. Isi hanya kalau ada frontend di domain/port lain, contoh:
#   CORS_ORIGINS=http://localhost:5173,https://app.domainlu.com
# Origin yang tidak terdaftar tidak mendapat header Access-Control-Allow-Origin.
CORS_ORIGINS=

# Level log: debug | info | warn | error (default: info).
# Log berformat JSON per baris; TIDAK PERNAH berisi password/token.
LOG_LEVEL=info

# ============================================================
# Phase 2A — Upstash Redis (distributed rate limiting)
# ============================================================
# Console.upstash.com → buat database REST → copy dua nilai ini.
# Tanpa ini, rate limiter jatuh ke mode in-memory per-instance (Phase 1).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# Phase 2C — Email (verifikasi + reset password)
# ============================================================
# Belum diimplement penuh — menyusul pilihan provider (Resend dsb).
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM=
